# ==============================================================================
# SENSIBLE DOCUMENT EXTRACTOR — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in production and configure the required parameters.
# NEVER commit your production '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------

# AUTH_SECRET_KEY
# Description: Cryptographic secret key used to sign and verify HS256 JWT access tokens.
# Required/Optional: REQUIRED in production (a hardcoded fallback exists for dev only).
# How to obtain: Generate a 64-character cryptographically secure random string using:
#                openssl rand -hex 32
# Safe Placeholder:
AUTH_SECRET_KEY=replace_with_64_character_cryptographically_secure_random_hex_string

# AUTH_DEV_MODE
# Description: Enables local/test development bypass (e.g. mock headers X-User-Id, demo user fallbacks).
# Required/Optional: REQUIRED (Must be 'false' in production; 'true' strictly for automated tests).
# How to obtain: Set to 'false'.
# Safe Placeholder:
AUTH_DEV_MODE=false

# AUTH_TOKEN_EXPIRY_MINUTES
# Description: Token lifespan before user session expires and requires re-login (in minutes).
# Required/Optional: OPTIONAL (Defaults to 1440 = 24 hours if omitted).
# How to obtain: Specify your preferred session duration in minutes (e.g. 1440 for 24 hours, 480 for 8 hours).
# Safe Placeholder:
AUTH_TOKEN_EXPIRY_MINUTES=1440


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------

# DATABASE_URL
# Description: Relational database connection string. SQLAlchemy engine handles connection pooling.
# Required/Optional: REQUIRED in production.
# How to obtain: 
#   - For Production (PostgreSQL recommended): postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
#   - For Lightweight/Local (SQLite): sqlite:///./senseible_documents.db
# Safe Placeholder:
DATABASE_URL=postgresql://sensible_user:your_secure_db_password@localhost:5432/sensible_db


# ------------------------------------------------------------------------------
# 3. AI / LLM SERVICES (GOOGLE GEMINI - OPTIONAL BUT STRONGLY RECOMMENDED)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY
# Description: Google Gemini API key used for structured document extraction JSON parsing and Copilot RAG natural language assistance.
# Required/Optional: OPTIONAL (If omitted, the platform runs 100% deterministically using regex heuristics and local emission factor rules without failing).
# How to obtain: Sign up at https://aistudio.google.com/app/apikey and generate a new Gemini API key.
# Safe Placeholder:
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL
# Description: Google Gemini model identifier used for extraction and conversational reasoning.
# Required/Optional: OPTIONAL (Defaults to 'gemini-2.5-flash' if omitted).
# How to obtain: Choose from 'gemini-2.5-flash', 'gemini-2.0-flash', or 'gemini-1.5-flash'.
# Safe Placeholder:
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------------------------
# 4. FILE STORAGE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------

# UPLOAD_DIR
# Description: Local absolute or relative filesystem path where uploaded PDF documents are securely stored.
# Required/Optional: OPTIONAL (Defaults to 'uploads' relative to backend directory).
# How to obtain: Specify the target persistent storage directory path (or container persistent volume mount).
# Safe Placeholder:
UPLOAD_DIR=uploads


# ------------------------------------------------------------------------------
# 5. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# HOST
# Description: Network interface host to bind the Uvicorn ASGI server.
# Required/Optional: OPTIONAL (Defaults to '0.0.0.0').
# Safe Placeholder:
HOST=0.0.0.0

# PORT
# Description: Port number on which the backend FastAPI server listens.
# Required/Optional: OPTIONAL (Defaults to 8005).
# Safe Placeholder:
PORT=8005


# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND ROUTING (PRODUCTION RECOMMENDATION)
# ------------------------------------------------------------------------------

# CORS_ORIGINS
# Description: Comma-separated list of allowed frontend origins for Cross-Origin Resource Sharing.
# Required/Optional: RECOMMENDED in production (replaces wildcard allow_origins=["*"] when cookies/credentials are used).
# How to obtain: List your production frontend domain(s) (e.g. https://app.sensible.io,https://sensible.io).
# Safe Placeholder:
CORS_ORIGINS=https://app.sensible.io,http://localhost:5173

# VITE_API_BASE_URL (Frontend Build Environment Variable)
# Description: Backend API base URL used by frontend axios client when not using reverse proxy.
# Required/Optional: OPTIONAL (Defaults to '/api' when using NGINX/Caddy reverse proxy or Vite dev proxy).
# How to obtain: Set to your public API gateway URL if frontend and backend are hosted on separate domains.
# Safe Placeholder:
# VITE_API_BASE_URL=https://api.sensible.io/api
